-- ============================================================
-- Archivo: 01_crear_tablas.sql
-- Descripción: Creación de la base de datos y las tablas.
-- 
-- NOTA IMPORTANTE:
-- La tabla stg_Datos NO se crea en este script.
-- Se generó automáticamente al usar el Asistente para importar
-- archivos planos de SSMS (Tareas → Importar archivo plano).
-- Ver el archivo 05_importar_excel.sql para más detalles.
-- ============================================================

USE master;
GO

-- Crea la base de datos si no existe
IF DB_ID('ETL_Encuesta') IS NULL
    CREATE DATABASE ETL_Encuesta;
GO

USE ETL_Encuesta;
GO

-- ============================================================
-- TABLA 1: Aceptados (registros válidos)
-- ============================================================
IF OBJECT_ID('dbo.Aceptados', 'U') IS NOT NULL 
    DROP TABLE dbo.Aceptados;
GO

CREATE TABLE Aceptados (
    SourceRowId       INT PRIMARY KEY,
    TipoDocumento     VARCHAR(10),
    NumeroDocumento   VARCHAR(20),
    NombreCompleto    VARCHAR(200),
    IngresoMensual    DECIMAL(18,2),
    GastoMensual      DECIMAL(18,2),
    BalanceMensual    DECIMAL(18,2)
);
GO

-- ============================================================
-- TABLA 2: Rechazados (registros con errores)
-- ============================================================
IF OBJECT_ID('dbo.Rechazados', 'U') IS NOT NULL 
    DROP TABLE dbo.Rechazados;
GO

CREATE TABLE Rechazados (
    SourceRowId  INT,
    Motivo       VARCHAR(300)
);
GO

-- ============================================================
-- Verificación
-- ============================================================
PRINT 'Tablas creadas por este script:';
SELECT name AS TablasCreadas 
FROM sys.tables 
WHERE name IN ('Aceptados', 'Rechazados')
ORDER BY name;
GO

PRINT 'Script 01 ejecutado correctamente.';
PRINT 'Recuerda: stg_Datos se crea al importar el Excel.';
GO









